# Copy to .env in this directory, or to ~/.make0/.env (the data folder).
# Make0 Brain reads ./.env first, then the data-folder .env.
# Variables already set in the environment win. Blank lines and # comments are ignored.

# API key. Enables duplicate merge, better categories, the LLM search filter,
# and `import --extract`. Set one of these:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# MAKE0_BRAIN_API_KEY=

# Any OpenAI-compatible endpoint. Optional.
# Defaults to https://api.openai.com/v1, or https://openrouter.ai/api/v1 for an OpenRouter key.
# A localhost URL needs no key and keeps everything on this machine:
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
# MAKE0_BRAIN_LLM_BASE_URL=

# Chat model. Default gpt-6-luna (openai/gpt-6-luna on OpenRouter), llama3.2 on localhost.
# MAKE0_BRAIN_LLM_MODEL=

# Embeddings: local (default, MiniLM) or api (text-embedding-3-small at 384 dims).
# MAKE0_BRAIN_EMBEDDINGS=local

# Embedding model when MAKE0_BRAIN_EMBEDDINGS=api. Optional.
# MAKE0_BRAIN_EMBEDDING_MODEL=

# Set to 0 to keep search on the local reranker when a key is set.
# With a localhost model, search stays local unless this is 1.
# MAKE0_BRAIN_LLM_SEARCH=

# Data folder. Default ~/.make0 (database and models).
# MAKE0_BRAIN_HOME=

# Database file. Default $MAKE0_BRAIN_HOME/brain.db.
# MAKE0_BRAIN_DB=
